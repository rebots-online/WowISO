# Large release artifacts → git-LFS (forgejo.robin.mba). House rule CC13.
dist/**/*.iso   filter=lfs diff=lfs merge=lfs -text
dist/**/*.img   filter=lfs diff=lfs merge=lfs -text
dist/**/*.squashfs filter=lfs diff=lfs merge=lfs -text
dist/**/*.tar.zst filter=lfs diff=lfs merge=lfs -text
dist/**/*.deb   filter=lfs diff=lfs merge=lfs -text
dist/**/*.rpm   filter=lfs diff=lfs merge=lfs -text
dist/**/*.AppImage filter=lfs diff=lfs merge=lfs -text
*.iso   filter=lfs diff=lfs merge=lfs -text
*.squashfs filter=lfs diff=lfs merge=lfs -text
*.img   filter=lfs diff=lfs merge=lfs -text

# Text normalization
* text=auto eol=lf
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf

# Linguist counts
docs/* linguist-documentation
